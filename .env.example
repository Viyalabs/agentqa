# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Playwright Configuration (optional overrides)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
MAX_PAGES_PER_SCAN=10

# Waitlist Notifications
# Resend (https://resend.com) — for email notifications on waitlist signup
RESEND_API_KEY=re_your_api_key_here
# Optional: sender address (must be a verified domain in Resend)
# RESEND_FROM_EMAIL=AgentQA <noreply@yourdomain.com>

# CallMeBot WhatsApp (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Step 1: Add +34 644 597 145 to your WhatsApp contacts as "CallMeBot"
# Step 2: Send "I allow callmebot to send me messages" to that number on WhatsApp
# Step 3: You'll receive your API key — paste it below
CALLMEBOT_API_KEY=your_callmebot_api_key_here
