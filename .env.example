# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection for migrations (node scripts/migrate.js)
# Get from: Dashboard → Project Settings → Database → Connection Pooling → Session mode → URI
# This uses IPv4 and works on all networks (recommended over the direct URL)
SUPABASE_POOLER_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# App Configuration
# Local dev: http://localhost:3000
# Production (set in Vercel env vars): https://agentqa.viyalabs.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Playwright Configuration (optional overrides)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=10000
MAX_PAGES_PER_SCAN=5
MAX_CRAWL_DEPTH=1

# Waitlist Notifications
# Resend (https://resend.com) — for email notifications on waitlist signup
RESEND_API_KEY=re_your_api_key_here

# OPTION A — domain not yet verified in Resend (quick start):
#   Set RESEND_FROM_EMAIL=onboarding@resend.dev
#   Set RESEND_NOTIFY_EMAIL=<the email you signed up to Resend with>
#   Resend only allows sending to the account email without domain verification.
#
# OPTION B — domain verified in Resend (production):
#   Verify viyalabs.com at resend.com/domains, then use:
#   RESEND_FROM_EMAIL=AgentQA <noreply@viyalabs.com>
#   RESEND_NOTIFY_EMAIL=support@viyalabs.com  (or leave unset — that's the default)
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_NOTIFY_EMAIL=your-resend-account-email@example.com

# CI/CD Webhook
# A secret string you create — pass it as x-api-key header when calling POST /api/webhook/scan
# Generate one with: openssl rand -hex 32
WEBHOOK_API_KEY=your_webhook_secret_here

# Worker endpoint protection (optional but recommended)
# When set, POST /api/scan/worker requires x-worker-secret header to match this value
# Generate one with: openssl rand -hex 32
WORKER_SECRET=your_worker_secret_here

# Cron protection — Vercel sets this automatically (Pro plan); set manually if self-hosting
CRON_SECRET=your_cron_secret_here

# AI Analysis (optional — enhances scan results with Claude AI)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AI model tiering (optional)
# Set to "true" to use Claude Sonnet for critical JS/network crashes (higher quality, higher cost).
# Default: Haiku for all issue types.
AI_PREMIUM_MODEL=false

# ── Internal / Founder Access ────────────────────────────────────────────────
# Comma-separated email addresses that bypass all rate limits and get
# unlimited scans, full AI analysis, and debug info in API responses.
# Example: INTERNAL_EMAILS=founder@company.com,qa@company.com
INTERNAL_EMAILS=

# Comma-separated emails for beta testers — elevated limits (20 scans/hr),
# no debug info. Leave empty if you have no beta program yet.
BETA_EMAILS=

# Founder token: send as x-founder-token request header to get admin access
# without needing to provide your email in the scan form.
# Useful for internal scripts, CI pipelines, or quick demo scanning.
# Generate: openssl rand -hex 32
FOUNDER_TOKEN=

# Issue Intelligence — semantic embeddings (optional but recommended)
# Enables: semantic clustering, cross-framework correlation, signature similarity matching
# Model used: text-embedding-3-small ($0.02/1M tokens)
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Authenticated scanning — session encryption key
# AES-256-GCM key for encrypting stored auth credentials (cookies, tokens, etc.)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=your_64_hex_char_key_here

# CallMeBot WhatsApp (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Step 1: Add +34 644 597 145 to your WhatsApp contacts as "CallMeBot"
# Step 2: Send "I allow callmebot to send me messages" to that number on WhatsApp
# Step 3: You'll receive your API key — paste it below
CALLMEBOT_API_KEY=your_callmebot_api_key_here
# Your WhatsApp phone number (with country code, no + prefix), e.g. 919876543210
CALLMEBOT_PHONE=your_phone_number_here
